---
import Layout from "../layouts/layout.astro";
import Hero from "../components/Hero.astro";

const stats = [
  { value: "50+", label: "Proyectos entregados" },
  { value: "99.9%", label: "Uptime garantizado" },
  { value: "<1.2s", label: "Tiempo de carga medio" },
  { value: "100%", label: "Clientes satisfechos" },
];

const services = [
  {
    number: "01",
    title: "Diseño & Desarrollo Web",
    description:
      "Sitios corporativos, landing pages y plataformas SaaS construidas desde cero con tecnología punta y diseño completamente a medida.",
  },
  {
    number: "02",
    title: "Optimización de Rendimiento",
    description:
      "Auditorías técnicas profundas, Core Web Vitals y arquitectura de velocidad para que cada milisegundo cuente en tu tasa de conversión.",
  },
  {
    number: "03",
    title: "Infraestructura & Despliegue",
    description:
      "CI/CD automatizado, redes CDN globales y entornos cloud seguros con disponibilidad y monitorización de nivel enterprise.",
  },
];

const testimonial = {
  quote:
    "Iberian Web transformó completamente nuestra presencia digital. El tiempo de carga pasó de 4.8s a 0.9s y nuestras conversiones aumentaron un 38% en el primer mes.",
  author: "Carlos M.",
  role: "CEO, TechStartup Madrid",
};
---

<Layout>
  <Hero />

  <!-- Stats Strip -->
  <section class="border-y border-zinc-200 bg-zinc-50 dark:border-zinc-900 dark:bg-zinc-900/20">
    <div class="max-w-7xl mx-auto px-6 py-10 grid grid-cols-2 md:grid-cols-4 gap-8">
      {stats.map(({ value, label }) => (
        <div class="text-center space-y-1.5">
          <div class="text-3xl sm:text-4xl font-black text-blue-600 dark:text-blue-400">{value}</div>
          <div class="text-xs text-zinc-500 dark:text-zinc-400 tracking-widest uppercase font-medium">{label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- Services Preview -->
  <section class="max-w-7xl mx-auto px-6 py-16 md:py-24 space-y-12">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
      <div class="space-y-3">
        <span class="text-xs font-bold tracking-widest text-blue-600 dark:text-blue-400 uppercase">Servicios</span>

        <h2 class="text-3xl sm:text-4xl font-black text-zinc-900 dark:text-white tracking-tight">Lo que construimos.</h2>
      </div>

      <a
        href="/services"
        class="text-sm text-zinc-500 hover:text-blue-600 dark:text-zinc-400 dark:hover:text-blue-400 transition-colors flex items-center gap-2 group shrink-0"
      >
        Ver todos los servicios
        <svg
          class="w-4 h-4 group-hover:translate-x-1 transition-transform"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {services.map(({ number, title, description }) => (
        <div class="group p-8 bg-zinc-50 border border-zinc-200 rounded-xl space-y-5 hover:border-blue-500/25 hover:bg-zinc-100 dark:bg-zinc-900/30 dark:border-zinc-900 dark:hover:bg-zinc-900/60 transition-all duration-300">
          <span class="text-xs text-blue-600 dark:text-blue-400 font-semibold">{number}</span>

          <div class="space-y-3">
            <h3 class="text-xl font-bold text-zinc-900 dark:text-white tracking-tight group-hover:text-blue-600 dark:group-hover:text-blue-50 transition-colors">
              {title}
            </h3>

            <p class="text-sm text-zinc-500 dark:text-zinc-400 font-light leading-relaxed">{description}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <hr class="border-zinc-200 dark:border-zinc-900 max-w-7xl mx-auto px-6" />

  <!-- Philosophy Statement -->
  <section class="py-16 md:py-24 max-w-5xl mx-auto px-6 text-center space-y-8">
    <span class="text-xs font-bold tracking-widest text-blue-600 dark:text-blue-400 uppercase">Nuestra Filosofía</span>

    <blockquote class="text-2xl sm:text-4xl font-bold tracking-tight text-zinc-700 dark:text-zinc-200 leading-tight">
      "La complejidad es fácil de construir; lo verdaderamente sofisticado es lograr una solución
      <span class="text-blue-600 dark:text-blue-400"> limpia, rápida y perfectamente integrada</span>
      ."
    </blockquote>

    <div class="h-px w-12 bg-blue-500/40 mx-auto"></div>

    <a
      href="/about"
      class="inline-flex items-center space-x-2 text-sm text-zinc-500 hover:text-blue-600 dark:text-zinc-400 dark:hover:text-blue-400 transition-colors group"
    >
      <span>Conoce más sobre nosotros</span>

      <svg
        class="w-4 h-4 group-hover:translate-x-1 transition-transform"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>
  </section>

  <hr class="border-zinc-200 dark:border-zinc-900 max-w-7xl mx-auto px-6" />

  <!-- Testimonial -->
  <section class="max-w-4xl mx-auto px-6 py-16 md:py-24 text-center space-y-8">
    <span class="text-xs font-bold tracking-widest text-blue-600 dark:text-blue-400 uppercase">Resultados reales</span>

    <div class="p-10 bg-zinc-50 border border-zinc-200 rounded-2xl space-y-6 relative overflow-hidden dark:bg-zinc-900/40 dark:border-zinc-800">
      <div
        class="absolute top-0 left-0 right-0 h-px"
        style="background: linear-gradient(90deg, transparent, rgba(59,130,246,0.4), transparent);"
      ></div>

      <div class="flex justify-center gap-1">
        {Array.from({ length: 5 }).map(() => (
          <svg class="w-4 h-4 text-blue-600 dark:text-blue-400" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
        ))}
      </div>

      <p class="text-xl sm:text-2xl text-zinc-700 dark:text-zinc-200 font-light leading-relaxed italic">"{testimonial.quote}"</p>

      <div>
        <p class="text-zinc-900 dark:text-white font-semibold">{testimonial.author}</p>
        <p class="text-sm text-zinc-500">{testimonial.role}</p>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="max-w-7xl mx-auto px-6 pb-16 md:pb-24">
    <div
      class="rounded-2xl border border-blue-500/20 p-12 sm:p-16 text-center space-y-6 relative overflow-hidden bg-zinc-50 dark:bg-[#09090b]"
      style="background-image: radial-gradient(ellipse 80% 60% at 50% 50%, rgba(59,130,246,0.06) 0%, transparent 70%);"
    >
      <div
        class="absolute inset-0 rounded-2xl pointer-events-none"
        style="background: linear-gradient(135deg, rgba(59,130,246,0.04) 0%, transparent 50%);"
      ></div>

      <span class="relative text-xs font-bold tracking-widest text-blue-600 dark:text-blue-400 uppercase">¿Empezamos?</span>

      <h2 class="relative text-3xl sm:text-4xl font-black text-zinc-900 dark:text-white tracking-tight">
        Tu próximo proyecto empieza con una conversación.
      </h2>

      <p class="relative text-zinc-500 dark:text-zinc-400 max-w-xl mx-auto font-light">
        Consultoría inicial sin coste. Cuéntanos qué necesitas y te responderemos en menos de 24 horas con un plan de
        acción concreto.
      </p>

      <a
        href="/contact"
        class="relative inline-flex items-center space-x-2 px-10 py-4 bg-blue-600 dark:bg-blue-400 text-white dark:text-zinc-950 font-bold rounded-md hover:bg-blue-700 dark:hover:bg-blue-500 transition-all text-sm tracking-wide"
        style="box-shadow: 0 8px 32px rgba(59,130,246,0.25);"
      >
        <span>Iniciar Proyecto</span>

        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </section>
</Layout>
