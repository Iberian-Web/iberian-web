---
import ArrowRight from "@lucide/astro/icons/arrow-right";

const currentYear = new Date().getFullYear();
---

<section class="relative max-w-7xl mx-auto px-6 pt-16 pb-16 md:pt-40 md:pb-36 flex flex-col items-center text-center overflow-hidden">
  <!-- Subtle ambient glow -->
  <div
    class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(ellipse 70% 50% at 50% -10%, rgba(59,130,246,0.09) 0%, transparent 70%);"
  ></div>

  <div class="relative inline-flex items-center space-x-2 bg-blue-500/10 border border-blue-500/20 px-4 py-1.5 rounded-full text-xs font-semibold text-blue-600 dark:text-blue-400 mb-8 tracking-widest uppercase">
    <span
      class="w-1.5 h-1.5 rounded-full bg-blue-400"
      style="animation: pulse 2s cubic-bezier(0.4,0,0.6,1) infinite;"
    ></span>

    <span>Calendario abierto para nuevos proyectos · {currentYear}</span>
  </div>

  <h1 class="relative text-5xl sm:text-7xl lg:text-[5.5rem] font-black tracking-tight max-w-5xl text-zinc-900 dark:text-white leading-none mb-8">
    Ingeniería web para marcas <span class="text-blue-600 dark:text-blue-400">con visión</span> de futuro.
  </h1>

  <p class="relative text-lg sm:text-xl text-zinc-600 dark:text-zinc-300 max-w-2xl font-light leading-relaxed mb-12">
    Diseñamos y desplegamos ecosistemas web ultra rápidos, limpios y escalables — optimizados desde el primer píxel para
    maximizar la conversión de tu negocio.
  </p>

  <div class="relative flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto">
    <a
      href="/contact"
      class="w-full sm:w-auto text-center px-8 py-4 bg-blue-600 dark:bg-blue-400 text-white dark:text-zinc-950 font-bold rounded-md hover:bg-blue-700 dark:hover:bg-blue-500 transition-all text-sm tracking-wide"
      style="box-shadow: 0 8px 32px rgba(59,130,246,0.25);"
    >
      Agendar Consultoría Gratuita
    </a>

    <a
      href="/services"
      class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 bg-zinc-100 text-zinc-600 font-medium rounded-md border border-zinc-300 hover:text-zinc-900 hover:bg-zinc-200 dark:bg-zinc-900 dark:text-zinc-300 dark:border-zinc-800 dark:hover:text-white dark:hover:bg-zinc-800 transition-all text-sm tracking-wide"
    >
      <span>Explorar Soluciones</span>
      <ArrowRight class="w-4 h-4" />
    </a>
  </div>
</section>
