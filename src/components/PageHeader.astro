---
interface Props {
  eyebrow: string;
  class?: string;
  titleClass?: string;
  descriptionClass?: string;
}

const {
  eyebrow,
  class: className = "",
  titleClass = "text-4xl sm:text-6xl font-black tracking-tight text-white leading-[1.05]",
  descriptionClass = "max-w-2xl text-lg",
} = Astro.props;
---

<section class={`relative max-w-5xl mx-auto px-6 pt-16 md:pt-24 pb-12 md:pb-16 text-center space-y-6 overflow-hidden ${className}`}>
  <div
    class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(ellipse 60% 40% at 50% 0%, rgba(59,130,246,0.07) 0%, transparent 70%);"
  ></div>

  <span class="relative text-xs font-bold tracking-widest text-blue-500 uppercase">{eyebrow}</span>

  <h1 class={`relative ${titleClass}`}>
    <slot name="title" />
  </h1>

  <p class={`relative text-zinc-300 mx-auto font-light leading-relaxed ${descriptionClass}`}>
    <slot />
  </p>
</section>
