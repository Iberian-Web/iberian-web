---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-zinc-200 bg-white text-zinc-500 text-xs py-12 dark:border-zinc-900 dark:bg-zinc-950 transition-colors">
  <div class="max-w-7xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="flex items-center space-x-2">
      <img src="/favicon.svg" alt="Iberian Web" class="w-8 h-8 object-contain hidden dark:block" />
      <img src="/favicon_black.svg" alt="Iberian Web" class="w-8 h-8 object-contain block dark:hidden" />
      <span class="font-bold text-zinc-700 dark:text-zinc-300">Iberian Web</span>
      <span>&copy; {currentYear} &mdash; Todos los derechos reservados.</span>
    </div>
    <div class="flex space-x-6 text-zinc-500">
      <a href="/terms" class="hover:text-zinc-900 dark:hover:text-zinc-300 transition-colors">
        Términos
      </a>

      <a href="/privacy" class="hover:text-zinc-900 dark:hover:text-zinc-300 transition-colors">
        Privacidad
      </a>
    </div>
  </div>
</footer>
